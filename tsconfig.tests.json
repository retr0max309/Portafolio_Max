{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/api/test/**/*.ts", "scripts/**/*.ts", "tests/e2e/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
